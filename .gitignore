# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# R package build artefacts
steCI.Rcheck/
*.tar.gz
*.tgz

# knitr / Quarto caches
*_cache/
.quarto/

# Regenerated simulation output. The pipeline (simulation/run_sim.R -> aggregate.R)
# writes per-replicate chunks and re-aggregated metrics here. The SMALL aggregated
# results needed to reproduce every figure/table are shipped under data/ instead,
# so this directory is regenerated locally and not tracked, with one exception:
# the per-replicate robustness output (Web Tables S4 and S7; about 0.9 MB) and its
# Slurm logs are shipped, at the path dev/robust_collect.R reads by default.
simulation/output/*
!simulation/output/robust/
!simulation/output/logs/
simulation/output/logs/*
!simulation/output/logs/robust_*

# Large per-replicate objects are never tracked anywhere (regenerated by the pipeline).
**/replicates_all.rds

# OS
.DS_Store
Thumbs.db

# M4 tie experiment: large inputs and per-task outputs (reps/ and canon_boot.rds are
# attached to GitHub release v0.0.1)
dev/m4_ties/reps/
dev/m4_ties/canon_boot.rds
dev/m4_ties/run_*.log
dev/m4_ties/validation.rds
# heart tie-handling check outputs (regenerated by dev/heart_ties/run_canonical_checks.sh)
dev/heart_ties/runs/
# S5 replicate smoke runs (run_s5_reps.R with S5_SMOKE=1)
dev/s5_rescore/reps_smoke/
